{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "cssPriority": "user",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": true,
  "notification-window-preferred-output": "DP-1",
  "notification-window-width": 480,
  "control-center-width": 470,
  "control-center-height": -1,
  "fit-to-screen": false,
  "control-center-margin-top": 16,
  "control-center-margin-right": 16,
  "control-center-margin-bottom": 0,
  "control-center-margin-left": 0,
  "control-center-exclusive-zone": true,
  "timeout": 8,
  "timeout-low": 4,
  "timeout-critical": 0,
  "transition-time": 200,
  "notification-grouping": true,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "relative-timestamps": true,
  "image-visibility": "when-available",
  "hide-on-clear": true,
  "hide-on-action": true,
  "keyboard-shortcuts": true,
  "text-empty": "All clear",
  "widgets": [
    "notifications"
  ],
  "widget-config": {
    "notifications": {
      "vexpand": false
    }
  },
  "scripts": {
    "runelite-focus": {
      "app-name": "RuneLite",
      "run-on": "action",
      "exec": "/home/phill/.config/swaync/focus-app.sh '^net%-runelite%-client%-RuneLite$'"
    }
  }
}

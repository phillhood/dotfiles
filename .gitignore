# ---- Public-repo secret guards (backstop; --no-folding already prevents dir-symlink leaks) ----
# ssh: private keys + host state
ssh/.ssh/id_*
ssh/.ssh/*_key
ssh/.ssh/*.pem
ssh/.ssh/known_hosts*
# ~/.gitignore_global has a bare `.claude`, which (being unanchored) matches this
# package's own directory and hides every file in it — files still get stowed, so
# a fresh clone silently lacks them. Re-include the directory for this repo only.
# The trailing slash matches directories only, so the per-file guards below still
# win regardless of ordering. Verified with `git check-ignore`.
!claude/.claude/

# claude package: credentials and per-user/runtime state
claude/.claude/.credentials.json
claude/.claude/history.jsonl
claude/.claude/settings.local.json
# settings.json is rewritten live by Claude Code → untracked; canonical copy in tools/canonical/
claude/.claude/settings.json
# plugin registry + marketplaces are runtime state Claude rewrites (breaks the symlink)
claude/.claude/plugins/

# ---- Desktop packages: build/backup/state, never track ----
# hypr bundles a git-clone of split-monitor-workspaces (rebuilt by hyprpm)
hypr/.config/hypr/plugins/
# waybar keeps old config snapshots
waybar/.config/waybar/backup/
# herdr rewrites sockets/logs/session state beside its config; only config.toml is tracked
herdr/.config/herdr/*.log
herdr/.config/herdr/*.sock
herdr/.config/herdr/session.json
herdr/.config/herdr/release-notes.json
herdr/.config/herdr/.plugins.lock
# `herdr config reset-keys` writes config.toml.bak-keybind-v2-<epoch>, which the
# generic *.bak rule above does not match (it is not a .bak suffix)
herdr/.config/herdr/*.bak*
# editor/backup copies anywhere
*.bak

# ---- Session artifacts: per-session planning/implementation docs, never track ----
# No trailing slash: in a git worktree both are symlinks back to the main checkout,
# and a directory-only rule leaves the symlink showing as untracked.
.dev
.docs

#!/bin/zsh

###### Docker Utilities ######

# Formatted docker stats sorted by container name
dockstats() {
    watch -n 1 'STATS=$(docker stats --no-stream --format "table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.MemPerc}}\t{{.NetIO}}\t{{.BlockIO}}\t{{.PIDs}}") && 
    HEADER=$(echo "$STATS" | head -n 1) && 
    DATA=$(echo "$STATS" | tail -n +2 | sort) && 
    (echo "$HEADER" && echo "$DATA")'
}

# Color-coded logs for all running containers. Replicas (web-1, web-2) share a
# colour; with a prefix, every container whose name starts with it shares one.
# Usage: docklogs [prefix]
docklogs() {
  emulate -L zsh
  local pattern=$1 container group esc=$'\e'
  local -a colors=(31 32 33 34 35 36 37 91 92 93 94 95 96) pids
  local -A color_of
  local next=1

  for container in ${(f)"$(docker ps --format '{{.Names}}')"}; do
    if [[ -n $pattern && $container == ${pattern}* ]]; then
      group=$pattern
    else
      group=${container%[-_]<->}
    fi
    if (( ! ${+color_of[$group]} )); then
      color_of[$group]=${colors[next]}
      next=$(( next % $#colors + 1 ))
    fi
    docker logs -f $container 2>&1 |
      sed "s/^/${esc}[${color_of[$group]}m${container}${esc}[0m --- /" &
    pids+=($!)
  done

  (( $#pids )) || { print -u2 'docklogs: no running containers'; return 1 }
  trap "kill $pids 2>/dev/null" INT TERM
  wait
}
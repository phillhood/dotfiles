# Skeleton for ~/.ssh/config — copy to ~/.ssh/config on a fresh machine, then add
# host blocks for that machine below. Not stowed: colima and the AWS Toolkit write
# to this file, and a symlink would send those writes into the repo.
#
# The Include must stay first. ssh takes the FIRST value it finds for each keyword,
# so anything above it wins over the tracked fragments.
Include ~/.ssh/config.d/*.conf

# SSH key selection for GitHub is handled per-directory by git via core.sshCommand
# (see ~/.gitconfig and ~/.gitconfig-shy), so no github.com alias is needed here.

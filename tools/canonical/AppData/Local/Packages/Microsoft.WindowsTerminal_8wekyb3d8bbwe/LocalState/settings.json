        },
        {
            "id": "Terminal.PasteFromClipboard",
            "keys": "ctrl+v"
        },
        {
            "id": null,
            "keys": "alt+shift+d"
        },
        {
            "id": "User.ShiftEnterNewline",
            "keys": "shift+enter"
        },
        {
            "id": "Terminal.ClosePane",
            "keys": "ctrl+w"
        }
    ],

{
  // Use raw.githubusercontent.com to avoid untrusted GitHub redirect warnings
  "$schema": "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "padding": {
      "top": 0,
      "right": 3
    },
    "color": {
      "1": "#89dceb",
      "2": "#cba6f7",
      "3": "#f5c2e7",
      "4": "#f38ba8",
      "5": "#fab387",
      "6": "#f9e2af"
    }
  },
  "display": {
    "separator": " : ",
    "key": {
      "width": 0
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "      : Alakazam, bozo"
    },
    {
      "type": "custom",
      "format": "   ╭───────────────────────────────────────────╮"
    },
    {
      "type": "os",
      "key": "     󰍹 OS      ",
      "keyColor": "31"
    },
    {
      "type": "kernel",
      "key": "      Kernel  ",
      "keyColor": "33"
    },
    {
      "type": "packages",
      "key": "     󰏖 Packages",
      "keyColor": "32"
    },
    {
      "type": "command",
      "key": "     󰞷 Terminal",
      "text": "echo \"${TERM_PROGRAM:-$TERM} ${TERM_PROGRAM_VERSION%%-*}\"",
      "keyColor": "36"
    },
    {
      "type": "command",
      "key": "     󰓩 Mux     ",
      "text": "if [ -n \"$HERDR_ENV\" ]; then echo \"herdr (${HERDR_WORKSPACE_ID:-?})\"; elif [ -n \"$ZELLIJ\" ]; then echo zellij; elif [ -n \"$TMUX\" ]; then echo tmux; elif [ -n \"$STY\" ]; then echo screen; else echo none; fi",
      "keyColor": "34"
    },
    {
      "type": "wm",
      "key": "     󱂬 WM      ",
      "keyColor": "35"
    },
    {
      "type": "custom",
      "format": "   ╰───────────────────────────────────────────╯"
    },
    "break",
    {
      "type": "title",
      "key": "     󰮚",
      "format": "{1} @ {2}"
    },
    {
      "type": "custom",
      "format": "   ╭───────────────────────────────────────────╮"
    },
    {
      "type": "cpu",
      "key": "     󰻠 CPU     ",
      "keyColor": "31",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "     󰢮 GPU     ",
      "keyColor": "33",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": "     󰍛 Memory  ",
      "keyColor": "32"
    },
    {
      "type": "display",
      "key": "     󰹑 Display ",
      "keyColor": "36",
      "format": "{width}x{height} @ {refresh-rate} Hz"
    },
    {
      "type": "command",
      "key": "      OS Age  ",
      "text": "birth=$(stat -c %W / 2>/dev/null || stat -f %B / 2>/dev/null); [ ${birth:-0} -gt 0 ] && echo $(( ( $(date +%s) - birth ) / 86400 )) days || echo unknown",
      "keyColor": "34"
    },
    {
      "type": "uptime",
      "key": "     󰅐 Uptime  ",
      "keyColor": "35"
    },
    {
      "type": "custom",
      "format": "   ╰───────────────────────────────────────────╯"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 5
    },
    "break"
  ]
}